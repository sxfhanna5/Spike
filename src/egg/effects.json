{
  "_doc": "Light effects of the egg, defined once. The simulator (VirtualEgg) and the firmware (tools/gen-firmware.mjs → firmware/spike_egg/effects.h) both read this file. Times are in ms, intensities 0..1 (1 = max ring brightness, 100/255). Colours: #RRGGBB, $module (colour sent with C:) or 'heat' (the warm colour of each heat LED). No effect moves light around the ring and none flashes more than 3 times per second.",
  "limits": { "leds": 12, "maxBrightness": 100, "maxFlashesPerSecond": 3 },
  "effects": {
    "WAIT": {
      "desc": "Sin conexión: respiración lenta en azul claro.",
      "loop": true, "dur": 5000, "replaceBase": true,
      "layers": [
        { "kind": "breathe", "color": "#9FD8FF", "target": "all", "start": 0, "dur": 5000, "period": 5000, "min": 0.08, "max": 0.5 }
      ]
    },
    "CONNECT": {
      "desc": "Al conectar: el calor aparece con un fundido cálido.",
      "dur": 1800,
      "layers": [
        { "kind": "heatGain", "start": 0, "dur": 1600, "from": 0, "to": 1 },
        { "kind": "fade", "color": "#FFB46B", "target": "all", "start": 0, "dur": 1800, "from": 0.35, "to": 0 }
      ]
    },
    "PRESS": {
      "desc": "Pulsar un botón: destello corto de todos los LEDs al 30 %.",
      "dur": 220,
      "layers": [
        { "kind": "pulse", "color": "#FFFFFF", "target": "all", "times": [0], "len": 220, "peak": 0.3 }
      ]
    },
    "TURN_N": {
      "desc": "Empieza el turno del niño: dos pulsos suaves naranja.",
      "dur": 1900,
      "layers": [
        { "kind": "pulse", "color": "#FF8001", "target": "all", "times": [0, 950], "len": 900, "peak": 0.75 }
      ]
    },
    "TURN_P": {
      "desc": "Empieza el turno del padre: dos pulsos suaves azules.",
      "dur": 1900,
      "layers": [
        { "kind": "pulse", "color": "#45C1FF", "target": "all", "times": [0, 950], "len": 900, "peak": 0.75 }
      ]
    },
    "OK": {
      "desc": "Acierto: los LEDs nuevos se encienden de uno en uno en naranja cálido, con un destello dorado.",
      "dur": 1800,
      "layers": [
        { "kind": "seq", "color": "heat", "target": "new", "start": 0, "step": 260, "fade": 340 },
        { "kind": "pulse", "color": "#FFD34D", "target": "all", "times": [350], "len": 800, "peak": 0.5 }
      ]
    },
    "CASI": {
      "desc": "¡Casi!: una respiración lenta azul claro sobre el calor actual. El calor no baja y no hay rojo.",
      "dur": 3200,
      "layers": [
        { "kind": "breathe", "color": "#9FD8FF", "target": "all", "start": 0, "dur": 3200, "period": 3200, "min": 0, "max": 0.45 }
      ]
    },
    "TEACH": {
      "desc": "Modo maestro: pulso lila lento mientras dura.",
      "loop": true, "dur": 4000,
      "layers": [
        { "kind": "breathe", "color": "#E7B3FF", "target": "all", "start": 0, "dur": 4000, "period": 4000, "min": 0.08, "max": 0.65 }
      ]
    },
    "LEARNED": {
      "desc": "Fin del Modo maestro: doble pulso, lila y luego dorado.",
      "dur": 2100,
      "layers": [
        { "kind": "pulse", "color": "#E7B3FF", "target": "all", "times": [0], "len": 950, "peak": 0.75 },
        { "kind": "pulse", "color": "#FFD34D", "target": "all", "times": [1050], "len": 950, "peak": 0.8 }
      ]
    },
    "LEVELUP": {
      "desc": "Pasar de nivel: llena los 12 LEDs con el color del módulo, 3 pulsos grandes, chispas suaves al azar y reinicia.",
      "dur": 5600,
      "layers": [
        { "kind": "fade", "color": "$module", "target": "all", "start": 0, "dur": 800, "from": 0, "to": 0.55 },
        { "kind": "hold", "color": "$module", "target": "all", "start": 800, "dur": 2800, "level": 0.55 },
        { "kind": "pulse", "color": "$module", "target": "all", "times": [900, 1900, 2900], "len": 900, "peak": 0.45 },
        { "kind": "fade", "color": "$module", "target": "all", "start": 3600, "dur": 800, "from": 0.55, "to": 0 },
        { "kind": "sparkle", "palette": ["$module", "#FFFFFF"], "target": "all", "start": 3700, "dur": 1800, "rate": 2.5, "life": 900, "peak": 0.8 }
      ]
    },
    "HATCH": {
      "desc": "Eclosión: latido que se acelera, destello blanco, chispas multicolor lentas y calor cálido fijo.",
      "dur": 8200, "holdAfter": true,
      "layers": [
        { "kind": "pulse", "color": "#FFE9B0", "target": "all", "times": [0, 1300, 2400, 3300, 4000, 4500], "peaks": [0.35, 0.45, 0.55, 0.65, 0.8, 0.9], "len": 520, "peak": 0.5 },
        { "kind": "pulse", "color": "#FFFFFF", "target": "all", "times": [5100], "len": 600, "peak": 1 },
        { "kind": "sparkle", "palette": ["#E7B3FF", "#FF8001", "#45C1FF", "#73D83A", "#C48243"], "target": "all", "start": 5700, "dur": 2200, "rate": 2, "life": 1200, "peak": 0.8 },
        { "kind": "hold", "color": "#FFB46B", "target": "all", "start": 7700, "dur": 0, "level": 0.55, "fadeIn": 500 }
      ]
    },
    "FINAL": {
      "desc": "Al terminar todo: chispas con los colores de los 5 módulos.",
      "loop": true, "dur": 6000,
      "layers": [
        { "kind": "sparkle", "palette": ["#E7B3FF", "#FF8001", "#45C1FF", "#73D83A", "#C48243"], "target": "all", "start": 0, "dur": 6000, "rate": 3, "life": 1100, "peak": 0.9 }
      ]
    }
  }
}
